
#include <stdio.h>
#include <string.h>

struct Book
{
    int id;
    char name[50];
    char department[20];
};

int main()
{
    struct Book books[6] =
    {
        {101, "Engineering Mathematics", "Maths"},
        {102, "Calculus", "Maths"},
        {201, "Engineering Physics", "Physics"},
        {202, "Applied Physics", "Physics"},
        {301, "Engineering Chemistry", "Chemistry"},
        {302, "Organic Chemistry", "Chemistry"}
    };

    int role, choice, bookId;
    int i, found;
    char department[20];

    printf("\n===== LIBRARY MANAGEMENT SYSTEM =====\n");

    printf("\n1. Admin");
    printf("\n2. Maths Department");
    printf("\n3. Physics Department");
    printf("\n4. Chemistry Department");

    printf("\n\nEnter your role: ");
    scanf("%d", &role);

    if (role == 1)
    {
        strcpy(department, "Admin");
        printf("\nWelcome Admin!\n");
    }
    else if (role == 2)
    {
        strcpy(department, "Maths");
        printf("\nWelcome Maths Student!\n");
    }
    else if (role == 3)
    {
        strcpy(department, "Physics");
        printf("\nWelcome Physics Student!\n");
    }
    else if (role == 4)
    {
        strcpy(department, "Chemistry");
        printf("\nWelcome Chemistry Student!\n");
    }
    else
    {
        printf("\nInvalid role selected!\n");
        return 0;
    }

    do
    {
        printf("\n===== LIBRARY MENU =====");
        printf("\n1. View Books");
        printf("\n2. Search Book");
        printf("\n3. Exit");

        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("\nAvailable Books:\n");

            for (i = 0; i < 6; i++)
            {
                if (role == 1)
                {
                    printf("\nBook ID: %d", books[i].id);
                    printf("\nBook Name: %s", books[i].name);
                    printf("\nDepartment: %s\n", books[i].department);
                }
                else if (strcmp(department, books[i].department) == 0)
                {
                    printf("\nBook ID: %d", books[i].id);
                    printf("\nBook Name: %s", books[i].name);
                    printf("\nDepartment: %s\n", books[i].department);
                }
            }
        }
        else if (choice == 2)
        {
            printf("\nEnter Book ID: ");
            scanf("%d", &bookId);

            found = 0;

            for (i = 0; i < 6; i++)
            {
                if (books[i].id == bookId)
                {
                    found = 1;

                    if (role == 1 ||
                        strcmp(department, books[i].department) == 0)
                    {
                        printf("\nBook Found!");
                        printf("\nBook Name: %s", books[i].name);
                        printf("\nDepartment: %s\n", books[i].department);
                    }
                    else
                    {
                        printf("\nAccess Denied!");
                        printf("\nYou can only access books from your department.\n");
                    }

                    break;
                }
            }

            if (found == 0)
            {
                printf("\nBook ID not found!\n");
            }
        }
        else if (choice == 3)
        {
            printf("\nThank you for visiting the library!\n");
        }
        else
        {
            printf("\nInvalid choice! Try again.\n");
        }

    } while (choice != 3);

    return 0;
}
